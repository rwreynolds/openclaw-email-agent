# Server
API_HOST=0.0.0.0
API_PORT=8000

# OpenClaw Gateway (for webhooks)
OPENCLAW_GATEWAY_URL=http://your-droplet-ip:port
OPENCLAW_WEBHOOK_ENDPOINT=/webhooks/email
OPENCLAW_API_KEY=your-api-key

# OpenRouter (for LLM - email summarization and classification)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o

# Gmail Accounts (JSON array)
# Each account needs: email, app_password
# Generate app passwords at: https://myaccount.google.com/apppasswords
GMAIL_ACCOUNTS='[{"email": "your-email@gmail.com", "app_password": "your-app-password"}]'

# Polling
POLL_INTERVAL_MINUTES=15

# Classification Categories
EMAIL_CATEGORIES=Work,Personal,Newsletters,Spam,Notifications

# Logging
LOG_LEVEL=INFO
